// Oxide palette for Niri. Paste these blocks into ~/.config/niri/config.kdl
// (merge with your existing `layout {}` etc — these are illustrative defaults).
//
// Palette reference:
//   background       #121113   primary      #e78a53
//   background_alt   #0a0a0a   secondary    #5f8787
//   surface_alt      #222222   accent       #fbcb97
//   border           #333333   destructive  #c75a5a

layout {
    background-color "#121113"

    focus-ring {
        width 2
        active-color "#5f8787"      // secondary
        inactive-color "#222222"    // surface_alt
    }

    shadow {
        on
        softness 20
        spread 0
        offset x=0 y=4
        color "#0a0a0a80"           // background_alt @ 50% alpha
    }
}
